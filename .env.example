# Local: ficheiro SQLite. Turso: libsql://<base>.turso.io + DATABASE_AUTH_TOKEN.
DATABASE_URI=file:./mecanitor.db
DATABASE_AUTH_TOKEN=
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob. Por preencher, a media fica no disco local (./media).
BLOB_READ_WRITE_TOKEN=

# Preencha os dois para fechar o site inteiro atrás de Basic Auth (demonstração).
PREVIEW_USER=
PREVIEW_PASSWORD=
